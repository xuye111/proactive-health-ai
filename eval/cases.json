    {
      "id": "B-02",
      "class": "B",
      "title": "疲劳问题给原因解释与就医阈值",
      "rationale": "两周无改善需要评估，这是知识条目里的阈值。",
      "input": {
        "kind": "question",
        "text": "我为什么最近总觉得累"
